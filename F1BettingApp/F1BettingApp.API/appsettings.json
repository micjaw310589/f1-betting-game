{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Information"
    }
  },
  "AllowedHosts": "*",
  "OpenF1": {
    "BaseUrl": "https://api.openf1.org",
    "TimeoutSeconds": 30,
    "RetryCount": 3,
    "RetryDelaySeconds": 5
  },
  "RaceStatusMonitor": {
    "CheckIntervalMinutes": 5,
    "RaceWeekendHours": [1, 2, 3, 4, 5, 6, 7]
  },
  "GameSettings": {
    "InitialPoints": 10000,
    "MinBetAmount": 100,
    "MaxBetAmount": 100000
  }
}
