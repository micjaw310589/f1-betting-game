@startuml F1BettingGame_DomainModel
!theme blueprint

' === Value Objects ===
class Money {
  - _amount : decimal
  + Amount : decimal
  + FromDecimal(amount: decimal) : Money
  + Zero() : Money
  + Add(other: Money) : Money
  + Subtract(other: Money) : Money
  + Multiply(multiplier: decimal) : Money
  + Equals(other: Money) : boolean
  + GetHashCode() : int
}

class Odds {
  - _value : decimal
  + Value : decimal
  + FromDecimal(value: decimal) : Odds
  + CalculatePayout(betAmount: Money) : Money
  + Equals(other: Odds) : boolean
  + GetHashCode() : int
}

class RaceDate {
  - _dateTime : DateTime
  + Value : DateTime
  + FromDateTime(dateTime: DateTime) : RaceDate
  + Today() : RaceDate
  + Equals(other: RaceDate) : boolean
  + GetHashCode() : int
}

' === Entities ===
class User {
  + Id : int
  + Username : string
  + Email : string
  + PasswordHash : string
  + Points : int
  + CreatedAt : DateTime
  + ProfileImageUrl : string?
  + LastLogin : DateTime?
  + IsActive : boolean
  + IsAdmin : boolean
  --
  + AddPoints(points: int) : void
  + DeductPoints(points: int) : void
  + HasSufficientBalance(requiredPoints: int) : boolean
}

class Race {
  + Id : int
  + Name : string
  + Date : DateTime
  + Status : RaceStatus
  + Circuit : string
  + Country : string
  + OpenF1RaceId : string
  + Season : int
  + Bets : ICollection<Bet>
  --
  + CanPlaceBets() : boolean
  + IsRaceFinished() : boolean
}

class Driver {
  + Id : int
  + Name : string
  + Country : string
  + OpenF1DriverId : string
  + TeamId : int
  + Team : Team
  + Bets : ICollection<Bet>
  --
  + GetFullName() : string
}

class Team {
  + Id : int
  + Name : string
  + Country : string
  + OpenF1TeamId : string
  + Drivers : ICollection<Driver>
  --
  + GetDrivers() : string
}

class Bet {
  + Id : int
  + UserId : int
  + RaceId : int
  + DriverId : int
  + BetType : BetType
  + Amount : decimal
  + Odds : decimal
  + PotentialWinnings : decimal
  + Status : BetStatus
  + CreatedAt : DateTime
  --
  + ValidateBet() : void
}

class Result {
  + Id : int
  + RaceId : int
  + Race : Race
  + DriverId : int
  + Driver : Driver
  + UserId : int
  + User : User
  + Position : int
  + Points : int
  + FastestLap : TimeSpan?
  + PitStopTime : TimeSpan?
  --
  + IsPodiumFinish() : boolean
  + IsPointsFinish() : boolean
}

class LeaderboardHistory {
  + Id : int
  + UserId : int
  + User : User
  + RaceId : int
  + Race : Race
  + Season : string
  + TotalPoints : int
  + Rank : int
  + CreatedAt : DateTime
}

class Notification {
  + Id : int
  + UserId : int
  + User : User
  + Title : string
  + Message : string
  + IsRead : boolean
  + CreatedAt : DateTime
  --
  + MarkAsRead() : void
}

' === Enums ===
enum BetStatus {
  Pending
  Won
  Lost
  Canceled
}

enum BetType {
  Unknown = 0
  RaceWinner
  PodiumFinish
  Top10Finish
  FastestLap
  FastestPitStop
  DNFCount
  DriverVsDriver
  TeamVsTeam
}

enum RaceStatus {
  Scheduled
  InProgress
  Finished
  ResultsProcessed
}

enum NotificationType {
  BetPlaced
  BetWon
  BetLost
  RaceResultProcessed
  SystemMessage
}

' === Relationships ===
User "1" -- "*" Bet : places >
User "1" -- "*" Notification : receives >
User "1" -- "*" LeaderboardHistory : tracked in >
User "1" -- "*" Result : tied to >
Race "1" -- "*" Bet : for >
Race "1" -- "*" Result : has >
Race "1" -- "*" LeaderboardHistory : records >
Team "1" -- "*" Driver : has >
Driver "1" -- "*" Bet : selected in >
Driver "1" -- "*" Result : achieved by >

note right of Race
  Race captures a scheduled or completed
  Formula 1 event and associated betting state.
end note

@enduml