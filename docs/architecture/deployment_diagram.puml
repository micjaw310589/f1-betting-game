@startuml
title F1 Betting Game - Deployment Diagram

node "Client" as Client {
  artifact "Angular SPA" as SPA
}

node "Application Server" as AppServer {
  artifact "ASP.NET Core API" as API
  artifact "Application Services" as AppSvc
  artifact "Domain Model" as Domain
  artifact "Infrastructure" as Infra
}

database "SQL Server Database" as DB
node "External Service" as External {
  artifact "OpenF1 API" as OpenF1
}

SPA --> API : HTTPS/JSON
API --> AppSvc : service calls
AppSvc --> Domain : domain rules
AppSvc --> Infra : repositories
Infra --> DB : EF Core
AppSvc --> OpenF1 : sync race data

@enduml
