@startuml F1_BettingApp_Classes

skinparam linetype ortho
skinparam class {
  BackgroundColor #E1F5FF
  BorderColor #01579B
  ArrowColor #01579B
  FontName Arial
}

title F1 Betting Application — Class Diagram (Domain Layer)\n

' ============================================================
'  ENUMERATORS
' ============================================================

enum BetStatus {
  Pending
  Won
  Lost
  Canceled
}

enum RaceStatus {
  Scheduled
  InProgress
  Finished
  ResultsProcessed
}

' ============================================================
'  ENTITY CLASSES
' ============================================================

class User {
  - Id: int <<PK>>
  - Username: string
  - Email: string
  - PasswordHash: string
  - Points: int
  - CreatedAt: DateTime
  --
  + GetBets(): ICollection<Bet>
}

class Race {
  - Id: int <<PK>>
  - Name: string
  - Date: DateTime
  - Status: RaceStatus
  - Bets: ICollection<Bet>
  --
  + IsStarted(): bool
  + IsFinished(): bool
}

class Driver {
  - Id: int <<PK>>
  - Name: string
  - TeamId: int <<FK>>
  - Team: Team
  - Bets: ICollection<Bet>
  --
  + GetTeam(): Team
}

class Team {
  - Id: int <<PK>>
  - Name: string
  - Drivers: ICollection<Driver>
  --
  + GetAllDrivers(): ICollection<Driver>
}

class Bet {
  - Id: int <<PK>>
  - UserId: int <<FK>>
  - RaceId: int <<FK>>
  - DriverId: int <<FK>>
  - Amount: decimal
  - Status: BetStatus
  - CreatedAt: DateTime
  --
  + IsWon(): bool
  + IsLost(): bool
  + IsPending(): bool
  + CalculateWinnings(multiplier: decimal): decimal
}

' ============================================================
'  RELATIONSHIPS
' ============================================================

User "1" --o "*" Bet : "places"
Race "1" --o "*" Bet : "contains"
Driver "1" --o "*" Bet : "subject of"
Team "1" --o "*" Driver : "employs"
Bet "many" --> "one" BetStatus : "has status"
Race "many" --> "one" RaceStatus : "has status"

@enduml
