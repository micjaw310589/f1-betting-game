@startuml F1_BettingApp_ProjectStructure

!theme plain
skinparam backgroundColor #FEFEFE
skinparam note {
  BackgroundColor #FFFDE7
  BorderColor #F9A825
}
skinparam folder {
  BackgroundColor #E3F2FD
  BorderColor #01579B
}
skinparam file {
  BackgroundColor #F3E5F5
  BorderColor #6A1B9A
}

title F1 Betting Application — Project File Structure Diagram\n

' ============================================================
'  PROJECT ROOT
' ============================================================
folder "📁 f1-betting-game (Repository Root)" as root {
  
  ' ============================================================
  '  FRONTEND - Angular
  ' ============================================================
  folder "📁 src (Angular Frontend)" as angular_root {
    folder "📁 app" as app_folder {
      folder "📁 auth" as auth_module_folder {
        file "📄 auth.component.ts" as auth_comp
        file "📄 login.component.ts" as login_comp
        file "📄 register.component.ts" as register_comp
        file "📄 auth.service.ts" as auth_service
      }
      
      folder "📁 betting" as betting_module_folder {
        file "📄 betting.component.ts" as betting_comp
        file "📄 place-bet.component.ts" as place_bet_comp
        file "📄 betting.service.ts" as betting_service_fe
      }
      
      folder "📁 leaderboard" as leaderboard_folder {
        file "📄 leaderboard.component.ts" as leaderboard_comp
        file "📄 leaderboard.service.ts" as leaderboard_service_fe
      }
      
      folder "📁 race-details" as race_details_folder {
        file "📄 race-details.component.ts" as race_details_comp
        file "📄 race.service.ts" as race_service_fe
      }
      
      folder "📁 shared" as shared_folder {
        file "📄 http.interceptor.ts" as http_interceptor
        file "📄 auth.guard.ts" as auth_guard
        file "📄 models.ts" as models_fe
      }
    }
    
    folder "📁 assets" as assets_folder {
      file "📄 styles.css" as styles
      file "📄 images" as images
    }
    
    file "📄 main.ts" as main_ts
    file "📄 index.html" as index_html
  }
  
  ' ============================================================
  '  BACKEND - ASP.NET Core (.NET Solution)
  ' ============================================================
  folder "📁 F1BettingApp (.NET Solution)" as dotnet_root {
    
    ' ============================================================
    '  F1BettingApp.API
    ' ============================================================
    folder "📁 F1BettingApp.API" as api_project {
      folder "📁 Controllers" as api_controllers {
        file "📄 AuthController.cs" as auth_controller_be
        file "📄 BetsController.cs" as bets_controller_be
        file "📄 RacesController.cs" as races_controller_be
        file "📄 UsersController.cs" as users_controller_be
      }
      
      folder "📁 Middleware" as api_middleware {
        file "📄 ExceptionHandlingMiddleware.cs" as exception_middleware
        file "📄 AuthenticationMiddleware.cs" as auth_middleware
      }
      
      file "📄 Program.cs" as program_cs
      file "📄 appsettings.json" as appsettings
    }
    
    ' ============================================================
    '  F1BettingApp.Application
    ' ============================================================
    folder "📁 F1BettingApp.Application" as app_project {
      folder "📁 Services" as app_services {
        file "📄 BettingService.cs" as betting_service_be
        file "📄 RaceService.cs" as race_service_be
        file "📄 UserService.cs" as user_service_be
        file "📄 RankingService.cs" as ranking_service_be
      }
      
      folder "📁 DTOs" as app_dtos {
        file "📄 BetDto.cs" as bet_dto
        file "📄 RaceDto.cs" as race_dto
        file "📄 UserDto.cs" as user_dto
      }
      
      folder "📁 Interfaces" as app_interfaces {
        file "📄 IBettingService.cs" as ibetting_service
        file "📄 IRaceService.cs" as irace_service
      }
      
      folder "📁 Mappings" as app_mappings {
        file "📄 MappingProfile.cs" as mapping_profile
      }
      
      folder "📁 Validators" as app_validators {
        file "📄 BetValidator.cs" as bet_validator
        file "📄 RaceValidator.cs" as race_validator
      }
    }
    
    ' ============================================================
    '  F1BettingApp.Domain
    ' ============================================================
    folder "📁 F1BettingApp.Domain" as domain_project {
      folder "📁 Entities" as domain_entities {
        file "📄 User.cs" as user_entity_file
        file "📄 Bet.cs" as bet_entity_file
        file "📄 Race.cs" as race_entity_file
        file "📄 Driver.cs" as driver_entity_file
        file "📄 Team.cs" as team_entity_file
      }
      
      folder "📁 Enums" as domain_enums {
        file "📄 BetStatus.cs" as bet_status_file
        file "📄 RaceStatus.cs" as race_status_file
      }
      
      folder "📁 Exceptions" as domain_exceptions {
        file "📄 InsufficientBalanceException.cs" as insufficient_exc
      }
    }
    
    ' ============================================================
    '  F1BettingApp.Infrastructure
    ' ============================================================
    folder "📁 F1BettingApp.Infrastructure" as infra_project {
      folder "📁 Persistence" as infra_persistence {
        file "📄 AppDbContext.cs" as dbcontext_file
        file "📄 DbInitializer.cs" as dbinitializer
      }
      
      folder "📁 Repositories" as infra_repositories {
        file "📄 GenericRepository.cs" as generic_repo_file
        file "📄 IRepository.cs" as irepository
      }
      
      folder "📁 OpenF1" as openf1_folder {
        file "📄 OpenF1Client.cs" as openf1_client_file
        file "📄 OpenF1Models.cs" as openf1_models
      }
      
      folder "📁 BackgroundJobs" as background_jobs_folder {
        file "📄 RaceResultWorker.cs" as race_worker_file
        file "📄 OddsSyncWorker.cs" as odds_worker_file
      }
      
      folder "📁 Migrations" as migrations_folder {
        file "📄 InitialCreate.cs" as initial_migration
      }
    }
    
    ' ============================================================
    '  F1BettingApp.Tests
    ' ============================================================
    folder "📁 F1BettingApp.Tests" as tests_project {
      file "📄 BettingServiceTests.cs" as betting_tests
      file "📄 RaceServiceTests.cs" as race_tests
      file "📄 UserServiceTests.cs" as user_tests
    }
    
    file "📄 F1BettingApp.sln" as solution_file
  }
  
  ' ============================================================
  '  DOCUMENTATION
  ' ============================================================
  folder "📁 docs" as docs_folder {
    file "📄 ARCHITECTURE.md" as architecture_md
    file "📄 SPECIFICATION.md" as specification_md
    file "📄 STRUCTURE.md" as structure_md
    file "📄 db_schema.puml" as db_schema_diagram
    file "📄 class_diagram.puml" as class_diagram_file
    file "📄 architecture_component_diagram.puml" as component_diagram_file
    file "📄 architecture_layers_diagram.puml" as layers_diagram_file
    file "📄 01_create_database.sql" as create_db_script
    file "📄 02_seed_sample_data.sql" as seed_data_script
  }
  
  file "📄 README.md" as readme
  file "📄 .gitignore" as gitignore
}

' ============================================================
'  RELATIONSHIPS & DEPENDENCIES
' ============================================================

' Frontend to Backend API
betting_comp --> betting_service_fe
auth_comp --> auth_service
leaderboard_comp --> leaderboard_service_fe
race_details_comp --> race_service_fe

' Frontend Services to Backend
betting_service_fe ..> http_interceptor: "uses"
auth_service ..> http_interceptor: "uses"

' API Layer to Application
auth_controller_be ..> auth_service_be: "calls"
bets_controller_be ..> betting_service_be: "calls"
races_controller_be ..> race_service_be: "calls"

' Application to Domain
betting_service_be ..> bet_entity_file: "uses"
race_service_be ..> race_entity_file: "uses"
user_service_be ..> user_entity_file: "uses"

' Application to Infrastructure
betting_service_be ..> generic_repo_file: "uses"
race_service_be ..> generic_repo_file: "uses"

' Infrastructure to Domain
dbcontext_file ..> user_entity_file: "maps"
dbcontext_file ..> bet_entity_file: "maps"
dbcontext_file ..> race_entity_file: "maps"

' Background Jobs
race_worker_file ..> generic_repo_file: "uses"
odds_worker_file ..> generic_repo_file: "uses"
race_worker_file ..> openf1_client_file: "calls"

' Tests
betting_tests ..> betting_service_be: "tests"
race_tests ..> race_service_be: "tests"
user_tests ..> user_service_be: "tests"

' ============================================================
'  NOTES
' ============================================================

note right of angular_root
  **Frontend (Angular)**
  • Lazy-loaded modules
  • Reactive programming
  • HttpInterceptors for JWT
  • Component-based UI
end note

note right of api_project
  **API Layer**
  • RESTful endpoints
  • JWT authentication
  • Request/response handling
  • Swagger documentation
end note

note right of app_project
  **Application Layer**
  • Business logic services
  • Data validation
  • Mapping (DTOs)
  • Service interfaces
end note

note right of domain_project
  **Domain Layer**
  • Business models/entities
  • Enumerations
  • Domain exceptions
  • Core business rules
end note

note right of infra_project
  **Infrastructure Layer**
  • EF Core DbContext
  • Repository pattern
  • External APIs (OpenF1)
  • Background jobs
  • Database migrations
end note

note right of tests_project
  **Unit Tests**
  • xUnit framework
  • Moq for mocking
  • Service layer testing
  • Integration tests
end note

note right of docs_folder
  **Documentation**
  • Architecture decisions
  • Database schema
  • Diagrams (PlantUML)
  • Database scripts (SQL)
  • Specification & structure
end note

@enduml
