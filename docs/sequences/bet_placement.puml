@startuml
title Bet Placement Workflow Sequence Diagram

actor User
participant "Angular SPA" as SPA
participant "BetsController" as API
participant "BettingService" as BS
participant "User Repository" as UR
participant "Race Repository" as RR
participant "Bet Repository" as BR

User -> SPA : Submit bet details
SPA -> API : POST /api/bets
activate API
API -> BS : PlaceBetAsync(userId, raceId, driverId, amount)
activate BS

BS -> UR : GetByIdAsync(userId)
activate UR
UR --> BS : User
deactivate UR

BS -> RR : GetByIdAsync(raceId)
activate RR
RR --> BS : Race
deactivate RR

alt User has balance and race accepts bets
  BS -> BR : AddAsync(new Bet)
  activate BR
  BR --> BS : Bet tracked
  deactivate BR

  BS -> UR : UpdateAsync(user.Points -= amount)
  activate UR
  UR --> BS : User updated
  deactivate UR

  BS -> BR : SaveChangesAsync()
  activate BR
  BR --> BS : Changes persisted
  deactivate BR

  BS -> UR : SaveChangesAsync()
  activate UR
  UR --> BS : Changes persisted
  deactivate UR

  BS --> API : Success
else Validation failed
  BS --> API : InvalidOperationException
end

deactivate BS
API --> SPA : HTTP response
deactivate API

@enduml
