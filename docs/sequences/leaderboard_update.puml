@startuml
title Leaderboard Update Sequence Diagram

participant "Race Result Processor" as Trigger
participant "LeaderboardService" as LS
participant "User Service" as US
participant "Betting Service" as BS
participant "Database" as DB

note over Trigger, LS: Triggered after race result processing or point award
Trigger -> LS : requestLeaderboardUpdate(raceId)
activate LS

LS -> LS : Fetch all participants in the race
note right of LS: Use ResultService to get all finish data
LS -> DB : Get all Results for raceId
activate DB
DB --> LS : List of Result records
deactivate DB

LS -> LS : Group results by User ID
LS -> LS : Calculate total points gained/lost for the current race
note right of LS: Points calculation logic
LS -> DB : Read historical user points for base calculation
activate DB
DB --> LS : Current point totals for all users
deactivate DB

alt All participants processed
  LS -> LS : Calculate global rank based on accumulated points (TotalPoints)
  LS -> DB : Batch Update LeaderboardHistory (raceId, userId, totalPoints, rank)
  activate DB
  DB --> LS : History saved successfully
  deactivate DB
  LS --> Trigger : Leaderboard updated successfully
else Error processing point data
  LS --> Trigger : Failure (Missing data, race incomplete)
end

deactivate LS
@enduml