@startuml
title Leaderboard Update Sequence Diagram

participant "LeaderboardService" as LS
participant "User Repository" as UR
participant "Race Repository" as RR
participant "Leaderboard History Repository" as LHR

LS -> UR : GetAllAsync()
activate UR
UR --> LS : users
deactivate UR

LS -> RR : GetAllAsync()
activate RR
RR --> LS : races
deactivate RR

LS -> LHR : GetAllAsync()
activate LHR
LHR --> LS : history entries
deactivate LHR

LS -> LHR : DeleteAsync(currentSeason entries)
loop for each user ranked by points
  LS -> LHR : AddAsync(new LeaderboardHistory)
end
LS -> LHR : SaveChangesAsync()

@enduml
