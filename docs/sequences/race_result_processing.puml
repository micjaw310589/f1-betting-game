@startuml
title Race Result Processing Sequence Diagram

participant "RaceService" as RS
participant "BettingService" as BS
participant "Race Repository" as RR
participant "Bet Repository" as BR
participant "Result Repository" as ResR

RS -> RR : GetByIdAsync(raceId)
activate RR
RR --> RS : Race
deactivate RR

RS -> RR : UpdateAsync(race.Status = Finished)
RS -> RR : SaveChangesAsync()

BS -> RR : GetByIdAsync(raceId)
activate RR
RR --> BS : Race
deactivate RR

BS -> BR : GetAllAsync()
activate BR
BR --> BS : bets
deactivate BR

BS -> ResR : GetAllAsync()
activate ResR
ResR --> BS : results
deactivate ResR

loop for each pending bet on race
  BS -> BR : UpdateAsync(bet.Status = Won/Lost)
end
BS -> BR : SaveChangesAsync()

@enduml
